<!--                        </VBox>-->
<!--                     </content>-->
<!--                  </ScrollPane>-->
<!--               </Tab>-->
            </tabs>
         </TabPane>
      </VBox>
      </StackPane>
   </center>

   <bottom>
      <StackPane alignment="CENTER">
         <padding>
            <Insets top="10.0" right="40.0" bottom="18.0" left="40.0"/>
         </padding>

      <VBox maxWidth="1080.0" spacing="8.0">
         <Separator/>

         <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <Label fx:id="saveStatusLabel"
                   text=""
                   wrapText="true"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="resetDefaultsButton"
                    text="Reset defaults"/>
            <Button fx:id="cancelButton"
                    text="Cancel"
                    cancelButton="true"/>
            <Button fx:id="saveButton"
                    text="Save"
                    defaultButton="true"/>
         </HBox>
      </VBox>
      </StackPane>
   </bottom>
</BorderPane>
