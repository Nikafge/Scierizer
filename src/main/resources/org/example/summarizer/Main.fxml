<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="720.0"
            prefWidth="1120.0"
            styleClass="app-root"
            stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.summarizer.view.MainViewController">
  <top>
    <fx:include fx:id="topNavigation" source="TopNavigation.fxml" />
  </top>

  <center>
    <StackPane alignment="TOP_CENTER" styleClass="page-surface">
      <padding>
        <Insets top="48.0" right="40.0" bottom="40.0" left="40.0" />
      </padding>

      <VBox maxWidth="760.0" spacing="20.0">
        <VBox alignment="CENTER" spacing="6.0">
          <Text styleClass="page-title"
                text="Search arXiv papers or upload a PDF"
                textAlignment="CENTER"
                wrappingWidth="760.0" />
          <Text styleClass="page-subtitle"
                text="Find scientific papers, open a local PDF and summarize it"
                textAlignment="CENTER"
                wrappingWidth="760.0" />
          <Label styleClass="source-label"
                 text="Articles obtained via arXiv" />
        </VBox>

        <HBox spacing="12.0">
          <TextField fx:id="searchField"
                     prefHeight="38.0"
                     promptText="Search by title, authors or keywords"
                     HBox.hgrow="ALWAYS" />
          <Button fx:id="searchButton"
                  mnemonicParsing="false"
                  prefHeight="38.0"
                  prefWidth="92.0"
                  text="Search" />
          <Button fx:id="uploadPdfButton"
                  mnemonicParsing="false"
                  prefHeight="38.0"
                  prefWidth="112.0"
                  text="Upload PDF" />
        </HBox>

        <FlowPane hgap="8.0" vgap="8.0">
          <ToggleButton fx:id="physicsButton" mnemonicParsing="false" prefHeight="30.0" prefWidth="112.0" text="Physics" />
          <ToggleButton fx:id="compSciButton" mnemonicParsing="false" prefHeight="30.0" prefWidth="112.0" text="Comp-sci" />
          <ToggleButton fx:id="quantitativeFinanceButton" mnemonicParsing="false" prefHeight="30.0" prefWidth="140.0" text="Quant. finance" />
          <ToggleButton fx:id="engineeringButton" mnemonicParsing="false" prefHeight="30.0" prefWidth="122.0" text="Engineering" />
          <ToggleButton fx:id="mathButton" mnemonicParsing="false" prefHeight="30.0" prefWidth="122.0" text="Mathematics" />
          <ToggleButton fx:id="quantitativeBiologyButton" mnemonicParsing="false" prefHeight="30.0" prefWidth="128.0" text="Quant. biology" />
          <ToggleButton fx:id="statisticsButton" mnemonicParsing="false" prefHeight="30.0" prefWidth="112.0" text="Statistics" />
          <ToggleButton fx:id="economicsButton" mnemonicParsing="false" prefHeight="30.0" prefWidth="112.0" text="Economics" />
        </FlowPane>

        <ListView fx:id="paperResultsListView"
                  prefHeight="360.0"
                  VBox.vgrow="ALWAYS" />
        <Button fx:id="loadMoreButton"
                mnemonicParsing="false"
                maxWidth="1.7976931348623157E308"
                prefHeight="36.0"
                text="More results" />
        <Label fx:id="errorLabel"
               maxWidth="1.7976931348623157E308"
               text="" />
      </VBox>
    </StackPane>
  </center>
</BorderPane>
