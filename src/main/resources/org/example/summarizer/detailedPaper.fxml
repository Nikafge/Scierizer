<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="820.0"
            prefWidth="1280.0"
            styleClass="app-root"
            stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.summarizer.view.PaperDetailViewController">
   <top>
      <fx:include fx:id="topNavigation" source="TopNavigation.fxml" />
   </top>

   <center>
      <StackPane alignment="TOP_CENTER" styleClass="page-surface">
         <padding>
            <Insets top="36.0" right="44.0" bottom="40.0" left="44.0" />
         </padding>

         <VBox maxWidth="1180.0" spacing="16.0">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <Button fx:id="backButton"
                       mnemonicParsing="false"
                       text="Back" />
               <Label fx:id="titleLabel"
                      maxWidth="1.7976931348623157E308"
                      styleClass="page-title"
                      text="Paper title"
                      HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox spacing="24.0" VBox.vgrow="ALWAYS">
               <VBox spacing="12.0" prefWidth="430.0">
                  <Label styleClass="section-label" text="General information" />
                  <GridPane hgap="12.0" vgap="10.0">
                     <columnConstraints>
                        <ColumnConstraints minWidth="86.0" prefWidth="96.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                     </columnConstraints>

                     <Label styleClass="field-label" text="Authors:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                     <TextField fx:id="authorsField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                     <Label styleClass="field-label" text="Published:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                     <TextField fx:id="publishedField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                     <Label styleClass="field-label" text="Updated:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                     <TextField fx:id="updatedField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                     <Label styleClass="field-label" text="Source:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                     <TextField fx:id="sourceField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  </GridPane>

                  <Button fx:id="savePaperButton"
                          mnemonicParsing="false"
                          text="Save paper" />

                  <Label styleClass="section-label" text="Abstract" />
                  <TextArea fx:id="abstractArea"
                            prefHeight="430.0"
                            VBox.vgrow="ALWAYS" />
               </VBox>

               <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                  <Label styleClass="section-label" text="Summary type" />
                  <HBox spacing="8.0">
                     <ToggleButton fx:id="structured" mnemonicParsing="false" prefHeight="30.0" prefWidth="108.0" text="Structured" />
                     <ToggleButton fx:id="research" mnemonicParsing="false" prefHeight="30.0" prefWidth="92.0" text="Research" />
                     <ToggleButton fx:id="tldr" mnemonicParsing="false" prefHeight="30.0" prefWidth="76.0" text="TLDR" />
                     <ToggleButton fx:id="executive" mnemonicParsing="false" prefHeight="30.0" prefWidth="98.0" text="Executive" />
                  </HBox>

                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <Button fx:id="generateSummaryButton"
                             mnemonicParsing="false"
                             text="Generate summary" />
                     <ProgressIndicator fx:id="progressIndicator"
                                        prefHeight="28.0"
                                        prefWidth="28.0"
                                        progress="0.0" />
                     <Label fx:id="errorLabel"
                            maxWidth="1.7976931348623157E308"
                            text=""
                            HBox.hgrow="ALWAYS" />
                  </HBox>

                  <TextArea fx:id="generatedSummary"
                            prefHeight="520.0"
                            HBox.hgrow="ALWAYS"
                            VBox.vgrow="ALWAYS" />

                  <HBox alignment="CENTER_RIGHT">
                     <Region HBox.hgrow="ALWAYS" />
                     <Button fx:id="saveSummary"
                             mnemonicParsing="false"
                             text="Save summary" />
                  </HBox>
               </VBox>
            </HBox>
         </VBox>
      </StackPane>
   </center>
</BorderPane>
