<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0"
            prefWidth="1180.0"
            styleClass="app-root"
            stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.scierizer.view.SummaryDetailViewController">
   <top>
      <fx:include fx:id="topNavigation" source="TopNavigation.fxml" />
   </top>

   <center>
      <StackPane alignment="TOP_CENTER" styleClass="page-surface">
         <padding>
            <Insets top="36.0" right="44.0" bottom="40.0" left="44.0" />
         </padding>

         <VBox maxWidth="980.0" spacing="16.0">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <Button fx:id="backButton"
                       mnemonicParsing="false"
                       text="Back" />
               <Label fx:id="titleLabel"
                      maxWidth="1.7976931348623157E308"
                      styleClass="page-title"
                      text="Summary"
                      HBox.hgrow="ALWAYS" />
            </HBox>

            <GridPane hgap="14.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="100.0" prefWidth="110.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>

               <Label styleClass="field-label" text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
               <TextField fx:id="summaryTypeField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

               <Label styleClass="field-label" text="Published:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
               <TextField fx:id="publishedField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

               <Label styleClass="field-label" text="Source:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
               <TextField fx:id="sourceField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>

            <Label styleClass="section-label" text="Summary" />
            <TextArea fx:id="summaryArea"
                      prefHeight="420.0"
                      VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <Button fx:id="exportSummaryButton"
                       mnemonicParsing="false"
                       text="Export summary" />
               <Label fx:id="exportStatusLabel"
                      styleClass="status-label"
                      HBox.hgrow="ALWAYS" />
               <Region HBox.hgrow="ALWAYS" />
            </HBox>
         </VBox>
      </StackPane>
   </center>
</BorderPane>
